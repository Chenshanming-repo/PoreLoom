+//! Audited E7 pure simulation mechanics. No wall-clock or entropy dependencies.
+#![allow(missing_docs)]
+use std::time::Duration;
+#[derive(Debug,PartialEq)]
+pub(crate) enum Transition { None, Finalize, Acquire }
+pub(crate) fn transition(dead:bool,occupied:bool,finished:bool,unblocked:bool,now:Duration,ready:Duration)->Transition {
+ if dead {Transition::None} else if occupied && (finished || unblocked) {Transition::Finalize}
+ else if !occupied && now >= ready {Transition::Acquire} else {Transition::None}
+}
+pub(crate) fn produced_samples(elapsed:Duration,rate:u64,total:usize)->usize {
+ ((elapsed.as_nanos().saturating_mul(rate as u128)/1_000_000_000).min(total as u128)) as usize
+}
+pub(crate) fn packet_range(cursor:usize,produced:usize,terminal:bool,stopped:bool,bound:usize)->Option<std::ops::Range<usize>> {
+ if stopped || bound == 0 || produced <= cursor || (!terminal && produced-cursor < 300) {None}
+ else {Some(cursor..produced.min(cursor.saturating_add(bound)))}
+}
+pub(crate) fn named_weights(pairs:&[(String,usize)])->Result<(Vec<String>,Vec<usize>),String> {
+ let mut seen=std::collections::HashSet::new(); let mut names=Vec::new();let mut weights=Vec::new();
+ for (name,weight) in pairs {
+  if name.is_empty() || !seen.insert(name) {return Err("empty/duplicate sample name".into());}
+  names.push(name.clone());weights.push(*weight);
+ }
+ if names.is_empty() || !weights.iter().any(|w| *w>0) {return Err("empty/all-zero samples".into());}
+ Ok((names,weights))
+}
+/// E7 seed-v1: length-prefixed UTF8 FNV1a64 followed by SplitMix64 finalizer.
+pub(crate) fn domain_seed(root:u64,domain:&str,identity:&str)->u64 {
+ let mut hash=0xcbf29ce484222325u64;
+ for bytes in [b"Icarust-E7-seed-v1".as_slice(),root.to_le_bytes().as_slice(),domain.as_bytes(),identity.as_bytes()] {
+  for byte in (bytes.len() as u64).to_le_bytes().iter().chain(bytes.iter()) {
+   hash=(hash ^ (*byte as u64)).wrapping_mul(0x100000001b3);
+  }
+ }
+ hash=(hash ^ (hash>>30)).wrapping_mul(0xbf58476d1ce4e5b9);
+ hash=(hash ^ (hash>>27)).wrapping_mul(0x94d049bb133111eb);
+ hash ^ (hash>>31)
+}
+pub(crate) fn read_identity(root:u64,channel:usize,number:u32)->String {
+ let identity=format!("{channel}:{number}");
+ let a=domain_seed(root,"read-id-a",&identity);let b=domain_seed(root,"read-id-b",&identity);
+ format!("{:08x}-{:04x}-{:04x}-{:04x}-{:012x}",a>>32,(a>>16)&65535,(a&4095)|0x4000,((b>>48)&16383)|0x8000,b&0xffffffffffff)
+}
+pub(crate) fn identity_matches(id:&str,number:u32,requested_id:Option<&str>,requested_number:Option<u32>,occupied:bool,unblocked:bool)->bool {
+ occupied && !unblocked && match (requested_id,requested_number) {
+  (Some(wanted),None)=>wanted==id,(None,Some(wanted))=>wanted==number,_=>false
+ }
+}
+#[cfg(test)]
+mod tests {
+ use super::*;
+ #[test] fn failed_acquisition_retries_without_old_occupied_deadline() {
+  assert_eq!(transition(false,true,false,true,Duration::from_secs(1),Duration::ZERO),Transition::Finalize);
+  assert_eq!(transition(false,false,false,false,Duration::from_secs(2),Duration::from_secs(2)),Transition::Acquire);
+  assert_eq!(transition(false,false,false,false,Duration::from_secs(3),Duration::from_secs(2)),Transition::Acquire);
+ }
+ #[test] fn recovery_pause_is_absolute_and_channel_order_independent() {
+  for _ in 0..5 {assert_eq!(transition(false,false,false,false,Duration::from_millis(499),Duration::from_millis(500)),Transition::None);}
+  assert_eq!(transition(false,false,false,false,Duration::from_millis(500),Duration::from_millis(500)),Transition::Acquire);
+ }
+ #[test] fn dead_and_occupied_states_never_acquire_or_repeat_finalize() {
+  assert_eq!(transition(true,false,false,false,Duration::from_secs(100),Duration::ZERO),Transition::None);
+  assert_eq!(transition(false,true,false,false,Duration::from_secs(100),Duration::ZERO),Transition::None);
+  assert_eq!(transition(false,true,true,false,Duration::from_secs(1),Duration::ZERO),Transition::Finalize);
+  assert_eq!(transition(false,false,false,false,Duration::from_secs(1),Duration::from_secs(2)),Transition::None);
+ }
+ #[test] fn floor299_then300_cursor_tail_and_bounded_delay() {
+  assert_eq!(packet_range(0,299,false,false,12000),None);
+  assert_eq!(packet_range(0,300,false,false,12000),Some(0..300));
+  assert_eq!(packet_range(300,301,true,false,12000),Some(300..301));
+  assert_eq!(packet_range(0,40000,false,false,12000),Some(0..12000));
+  assert_eq!(packet_range(12000,40000,false,false,12000),Some(12000..24000));

+/// Write one ordered event; audit failures fail visibly rather than lose evidence.
+pub(crate) fn emit(mut event:serde_json::Value) {
+ #[cfg(test)] CAPTURE.with(|sink| {if let Some(events)=sink.borrow_mut().as_mut(){events.push(event.clone());}});
+ if let Some(audit)=AUDIT.get() {
+  let mut guard=audit.lock().unwrap();
+  event["audit_sequence"]=guard.2.into();event["monotonic_seconds"]=guard.1.elapsed().as_secs_f64().into();
+  serde_json::to_writer(&mut guard.0,&event).expect("audit serialization");
+  guard.0.write_all(b"\n").expect("audit write");guard.0.flush().expect("audit flush");guard.2+=1;
+ }
+}
+
+#[cfg(test)]
+thread_local! { static CAPTURE: std::cell::RefCell<Option<Vec<serde_json::Value>>> = std::cell::RefCell::new(None); }
+#[cfg(test)]
+pub(crate) fn capture<T>(f:impl FnOnce()->T)->(T,Vec<serde_json::Value>) {
+ CAPTURE.with(|sink| {assert!(sink.borrow().is_none());*sink.borrow_mut()=Some(Vec::new());});
+ let result=f();let events=CAPTURE.with(|sink|sink.borrow_mut().take().unwrap());(result,events)
+}

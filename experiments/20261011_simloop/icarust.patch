+/// Writer exit requires all buffered/queued records exhausted after producer stop.
+pub(crate) fn writer_finished(producer_done:bool,buffered:usize,received:usize)->bool {producer_done && buffered==0 && received==0}
+#[cfg(test)]
+mod writer_regressions {
+ use super::*;
+ #[test] fn shutdown_drains_multiple4000_batches_before_writer_exit() {
+  let mut buffered=9001;
+  while buffered>0 {
+   assert!(!writer_finished(true,buffered,0));buffered-=buffered.min(4000);
+  }
+  assert!(writer_finished(true,0,0));assert!(!writer_finished(false,0,0));assert!(!writer_finished(true,0,1));
+ }
+}
+
+/// Strict joint record/allocation capacity, checked before retaining a snapshot.
+pub(crate) fn retention_allows(count:usize,bytes:usize,next:usize,max_count:usize,max_bytes:usize)->bool {count.checked_add(1).map_or(false,|n|n<=max_count) && bytes.checked_add(next).map_or(false,|n|n<=max_bytes)}
+#[cfg(test)]
+mod capacity_regressions {
+ use super::*;
+ #[test] fn absent_slow_or_disconnected_consumer_hits_visible_count_and_byte_limits() {
+  assert!(retention_allows(4095,100,100,4096,256*1024*1024));
+  assert!(!retention_allows(4096,100,1,4096,256*1024*1024));
+  assert!(!retention_allows(1,256*1024*1024,2,4096,256*1024*1024));
+  assert!(!retention_allows(0,0,256*1024*1024+1,4096,256*1024*1024));
+  assert!(!retention_allows(0,usize::MAX,1,4096,256*1024*1024));
+ }
+}

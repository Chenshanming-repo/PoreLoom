+//! Additive source evidence for intentional censoring and physical transitions.
+use std::fs::{File,OpenOptions};
+use std::io::{Write,BufWriter};
+use std::path::Path;
+use std::sync::{Mutex,OnceLock};
+use std::time::Instant;
+static AUDIT: OnceLock<Mutex<(BufWriter<File>,Instant,u64)>>=OnceLock::new();
+fn create_fresh_audit(path:&Path)->std::io::Result<File> {
+ if let Some(parent)=path.parent() {
+  std::fs::create_dir_all(parent)?;
+ }
+ OpenOptions::new().write(true).create_new(true).open(path)
+}
+/// Create a fresh evidence file; never overwrite previous simulator evidence.
+pub(crate) fn initialize(path:&Path) {
+ let file=create_fresh_audit(path).expect("create new E7 engineering audit");

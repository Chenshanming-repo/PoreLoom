+/// Finalize an occupied read exactly once; transition guards prevent re-entry.
+fn finalize_snapshot(value:&mut ReadInfo,clock:Instant,rate:u64,pause:f64,dead:bool)->ReadInfo {
+    assert!(!value.read.is_empty(),"cannot finalize an already empty pore");
+    let final_clock=value.unblocked_at.unwrap_or(clock);
+    let produced=e7_engine::produced_samples(final_clock.saturating_duration_since(value.started),rate,value.read.len());
+    assert!(produced>=value.prev_chunk_start,"produced cursor behind emitted data");
+    let waveform=std::mem::take(&mut value.read);
+    let mut snapshot=value.clone();snapshot.read=waveform;snapshot.terminal_samples=Some(produced);snapshot.read.truncate(produced);
+    let censored=value.was_unblocked || value.stop_receiving || value.shutdown_reason.is_some();
+    e7_audit::emit(serde_json::json!({"event":"read_finalized","channel":value.channel,"read_id":value.read_id,"read_number":value.read_number,"produced_samples":produced,"prepared_samples":value.prev_chunk_start,"pending_samples":if censored {0} else {produced-value.prev_chunk_start},"intentionally_censored_samples":if censored {produced-value.prev_chunk_start} else {0},"shutdown_reason":value.shutdown_reason,"censor_start":value.prev_chunk_start,"censor_end":produced,"reason":if let Some(ref reason)=value.shutdown_reason {reason.as_str()} else if value.was_unblocked {"unblock"} else if value.stop_receiving {"stop_further_data"} else {"natural_end"},"permanent_dead":dead,"recovery_pause_seconds":pause}));
+    value.read.clear();value.was_unblocked=false;value.write_out=false;value.unblocked_at=None;
+    value.dead=dead;value.pause=pause;value.reacquire_at=clock+Duration::from_secs_f64(pause);

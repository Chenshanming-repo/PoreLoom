+ }
+ #[test] fn action_tails_are_censored_never_delivered() {
+  assert_eq!(packet_range(100,299,true,true,12000),None);
+  assert_eq!(packet_range(0,40000,true,true,12000),None);
+ }
+ #[test] fn monotonic_produced_cursor_is_precise_and_capped() {
+  assert_eq!(produced_samples(Duration::from_micros(74999),4000,1000),299);
+  assert_eq!(produced_samples(Duration::from_micros(75000),4000,1000),300);
+  assert_eq!(produced_samples(Duration::from_secs(99),4000,1000),1000);
+ }
+ #[test] fn profile_names_weights_stay_paired_and_duplicates_rejected() {
+  let pairs=vec![("host".into(),99),("target".into(),1)];
+  let (names,weights)=named_weights(&pairs).unwrap();
+  assert_eq!(names,vec!["host","target"]);assert_eq!(weights,vec![99,1]);
+  assert!(named_weights(&[("host".into(),99),("host".into(),1)]).is_err());
+  assert!(named_weights(&[]).is_err());assert!(named_weights(&[("x".into(),0)]).is_err());
+ }
+ #[test] fn versioned_seed_domains_and_read_ids_replay_without_physical_draws() {
+  assert_eq!(domain_seed(4,"length","host"),domain_seed(4,"length","host"));
+  assert_ne!(domain_seed(4,"length","host"),domain_seed(5,"length","host"));
+  assert_ne!(domain_seed(4,"length","host"),domain_seed(4,"death","host"));
+  assert_ne!(domain_seed(4,"ab","c"),domain_seed(4,"a","bc"));
+  assert_eq!(read_identity(4,1,2),read_identity(4,1,2));
+  assert_ne!(read_identity(4,1,2),read_identity(4,2,2));
+  assert_eq!(read_identity(4,1,2).len(),36);
+ }
+ #[test] fn stale_duplicate_missing_identities_reject() {
+  assert!(identity_matches("read",7,Some("read"),None,true,false));
+  assert!(identity_matches("read",7,None,Some(7),true,false));
+  assert!(!identity_matches("read",7,Some("old"),None,true,false));
+  assert!(!identity_matches("read",7,None,Some(6),true,false));
+  assert!(!identity_matches("read",7,None,None,true,false));
+  assert!(!identity_matches("read",7,Some("read"),None,true,true));
+  assert!(!identity_matches("read",7,Some("read"),None,false,false));
+ }
+}

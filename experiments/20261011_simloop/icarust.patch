+/// Prepare a contiguous bounded packet; action-censored identities never emit.
+fn read_packet(value:&mut ReadInfo,rate:u64,clock:Instant)->Option<ReadData> {
+    let terminal=value.terminal_samples.is_some();
+    let produced=value.terminal_samples.unwrap_or_else(||e7_engine::produced_samples(clock.saturating_duration_since(value.started),rate,value.read.len()));
+    let range=e7_engine::packet_range(value.prev_chunk_start,produced,terminal,value.stop_receiving || value.was_unblocked,3*rate as usize)?;
+    let bytes=convert_to_u8(value.read[range.clone()].to_vec());
+    // Evidence of preparation only: neither mpsc acceptance nor client receipt.
+    e7_audit::emit(serde_json::json!({"event":"packet_prepared","channel":value.channel,"read_id":value.read_id,"read_number":value.read_number,"sample_start":range.start,"sample_end":range.end,"start_sample":value.start_time,"offset":value.start_time+range.start as u64,"samples":range.len(),"terminal":terminal}));
+    value.prev_chunk_start=range.end;
+    Some(ReadData{id:value.read_id.clone(),number:value.read_number,start_sample:value.start_time,chunk_start_sample:value.start_time+range.start as u64,chunk_length:range.len() as u64,chunk_classifications:vec![83],raw_data:bytes,median_before:225.,median:110.})
+}

+/// One packet per channel per pass, with retained natural EOF snapshots first.
+fn collect_packets(reads:&mut [ReadInfo],pending:&mut VecDeque<ReadInfo>,rate:u64,clock:Instant)->Vec<(usize,ReadData)> {
+    let mut packets=Vec::new();let mut blocked=std::collections::HashSet::new();
+    for old in pending.iter_mut() {
+        if !blocked.insert(old.channel) {continue;}
+        if let Some(packet)=read_packet(old,rate,clock) {packets.push((old.channel,packet));}
+    }
+    pending.retain(|old|old.prev_chunk_start<old.terminal_samples.unwrap());
+    for current in reads.iter_mut() {
+        if blocked.contains(&current.channel) {continue;}
+        if let Some(packet)=read_packet(current,rate,clock) {packets.push((current.channel,packet));}
+    }
+    packets
+}
